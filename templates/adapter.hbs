<form>
  <p>PF1e uses its built-in integration. Other systems can use these inventory fields or register a system adapter.</p>
  <div class="form-group"><label>Item quantity field</label><input name="quantityPath" value="{{quantityPath}}" required></div>
  <div class="form-group"><label>Actor currency collection</label><input name="currencyPath" value="{{currencyPath}}" required></div>
  <div class="form-group"><label>Ledger item type</label><input name="ledgerType" value="{{ledgerType}}" placeholder="Automatic"></div>
  <button type="submit">Save Integration</button>
</form>
